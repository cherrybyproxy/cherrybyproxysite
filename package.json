{
  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.6.1",
    "framer-motion": "^12.23.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "react-scripts": "5.0.1",
    "web-vitals": "^3.5.2"
  },
  "scripts": {
    "convert-images": "CWEBP=$(command -v cwebp || echo '') && [ -z \"$CWEBP\" ] && echo 'cwebp not found, skipping conversion' || find src -type f \\( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \\) | while read f; do out=\"${f%.*}.webp\"; [ -f \"$out\" ] || $CWEBP -q 80 \"$f\" -o \"$out\" 2>/dev/null && echo \"Converted: $f\"; done",
    "prestart": "npm run convert-images",
    "prebuild": "npm run convert-images",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "eslint": "8.27.0",
    "eslint-plugin-react": "7.31.11"
  }
}
